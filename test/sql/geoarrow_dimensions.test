# The flat struct representation also carries z / m
query I
SELECT st_geomfromgeoarrow(st_asgeoarrow('LINESTRING (0 0, 4 0)'::GEOMETRY, 'xy'))::VARCHAR = 'LINESTRING (0 0, 4 0)'::GEOMETRY::VARCHAR;
----
true

query I
SELECT st_geomfromgeoarrow(st_asgeoarrow('LINESTRING Z (0 0 1, 4 0 2)'::GEOMETRY, 'xyz'))::VARCHAR = 'LINESTRING Z (0 0 1, 4 0 2)'::GEOMETRY::VARCHAR;
----
true

query I
SELECT st_geomfromgeoarrow(st_asgeoarrow('LINESTRING M (0 0 10, 4 0 11)'::GEOMETRY, 'xym'))::VARCHAR = 'LINESTRING M (0 0 10, 4 0 11)'::GEOMETRY::VARCHAR;
----
true

query I
SELECT st_geomfromgeoarrow(st_asgeoarrow('LINESTRING ZM (0 0 1 10, 4 0 2 11)'::GEOMETRY, 'xyzm'))::VARCHAR = 'LINESTRING ZM (0 0 1 10, 4 0 2 11)'::GEOMETRY::VARCHAR;
----
true
