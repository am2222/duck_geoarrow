----
true

query I
SELECT st_geomfromgeoarrow('multipoint', st_asgeoarrowmultipoint('MULTIPOINT Z (0 0 1, 4 0 2)'::GEOMETRY, 'xyz'))::VARCHAR = 'MULTIPOINT Z (0 0 1, 4 0 2)'::GEOMETRY::VARCHAR;
----
true

query I
SELECT st_geomfromgeoarrow('multilinestring', st_asgeoarrowmultilinestring('MULTILINESTRING Z ((0 0 1, 4 0 2), (4 4 3, 8 8 4))'::GEOMETRY, 'xyz'))::VARCHAR = 'MULTILINESTRING Z ((0 0 1, 4 0 2), (4 4 3, 8 8 4))'::GEOMETRY::VARCHAR;
----
true

query I
SELECT st_geomfromgeoarrow('multipolygon', st_asgeoarrowmultipolygon('MULTIPOLYGON Z (((0 0 1, 4 0 2, 4 4 3, 0 0 1)))'::GEOMETRY, 'xyz'))::VARCHAR = 'MULTIPOLYGON Z (((0 0 1, 4 0 2, 4 4 3, 0 0 1)))'::GEOMETRY::VARCHAR;
----
true

query I
SELECT st_geomfromgeoarrow('point', st_asgeoarrowpoint('POINT M (0 0 10)'::GEOMETRY, 'xym'))::VARCHAR = 'POINT M (0 0 10)'::GEOMETRY::VARCHAR;
----
