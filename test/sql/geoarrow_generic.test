# name: test/sql/geoarrow_generic.test
# description: st_geomfromgeoarrow('<type>', value) - the generic native reader (issue #7)
# group: [sql]

require duck_geoarrow

require parquet

# The generic form takes the geometry type as a string, so one call site handles any
# GeoArrow native encoding.
query I
SELECT st_geomfromgeoarrow('point', st_asgeoarrowpoint('POINT(30 10)'::GEOMETRY));
----
POINT (30 10)

query I
SELECT st_geomfromgeoarrow('polygon', st_asgeoarrowpolygon('POLYGON((0 0, 4 0, 4 4, 0 4, 0 0))'::GEOMETRY));
----
POLYGON ((0 0, 4 0, 4 4, 0 4, 0 0))

query I
SELECT st_geomfromgeoarrow('multipolygon', st_asgeoarrowmultipolygon('MULTIPOLYGON(((0 0, 1 0, 1 1, 0 0)))'::GEOMETRY));
----
MULTIPOLYGON (((0 0, 1 0, 1 1, 0 0)))

# The reason the type name is needed at all: these two DuckDB types are identical, so the
# same value is a valid LineString *and* a valid MultiPoint. The string decides.
query II
SELECT st_geomfromgeoarrow('linestring', [{'x': 0.0, 'y': 0.0}, {'x': 1.0, 'y': 1.0}]),
       st_geomfromgeoarrow('multipoint', [{'x': 0.0, 'y': 0.0}, {'x': 1.0, 'y': 1.0}]);
----
LINESTRING (0 0, 1 1)	MULTIPOINT (0 0, 1 1)

query II
SELECT st_geomfromgeoarrow('polygon', [[{'x': 0.0, 'y': 0.0}, {'x': 1.0, 'y': 0.0}, {'x': 1.0, 'y': 1.0}, {'x': 0.0, 'y': 0.0}]]),
       st_geomfromgeoarrow('multilinestring', [[{'x': 0.0, 'y': 0.0}, {'x': 1.0, 'y': 0.0}], [{'x': 2.0, 'y': 2.0}, {'x': 3.0, 'y': 3.0}]]);
----
POLYGON ((0 0, 1 0, 1 1, 0 0))	MULTILINESTRING ((0 0, 1 0), (2 2, 3 3))

# Type names are case- and separator-insensitive, and may carry an explicit dimension
# suffix that must then agree with the value
query IIII
SELECT st_geomfromgeoarrow('POINT', {'x': 1.0, 'y': 2.0}),
       st_geomfromgeoarrow('Point', {'x': 1.0, 'y': 2.0}),
       st_geomfromgeoarrow('point_z', {'x': 1.0, 'y': 2.0, 'z': 3.0}),
       st_geomfromgeoarrow('POINT ZM', {'x': 1.0, 'y': 2.0, 'z': 3.0, 'm': 4.0});
----
POINT (1 2)	POINT (1 2)	POINT Z (1 2 3)	POINT ZM (1 2 3 4)

# Dimensions are inferred from the value when the name carries no suffix
query II
SELECT st_geomfromgeoarrow('linestring', [{'x': 0.0, 'y': 0.0, 'm': 7.0}, {'x': 1.0, 'y': 1.0, 'm': 8.0}]),
       st_geomfromgeoarrow('point', {'x': 1.0, 'y': 2.0, 'z': 3.0, 'm': 4.0});
----
LINESTRING M (0 0 7, 1 1 8)	POINT ZM (1 2 3 4)

# NULL in, NULL out
query I
SELECT st_geomfromgeoarrow('polygon', NULL::STRUCT(x DOUBLE, y DOUBLE)[][]) IS NULL;
----
true

# Multi-row with NULLs
query II
SELECT id, st_geomfromgeoarrow('point', pt) FROM (VALUES
  (1, {'x': 1.0, 'y': 2.0}),
  (2, NULL),
  (3, {'x': -3.5, 'y': 4.25})
) t(id, pt) ORDER BY id;
----
1	POINT (1 2)
2	NULL
3	POINT (-3.5 4.25)

# Reads the real geopandas-written GeoParquet file through the generic form
query II
SELECT count(*), count(st_geomfromgeoarrow('polygon', geometry))
FROM 'test/data/ms_counties.parquet';
----
82	82

# Agrees with the per-type function on every row
query I
SELECT count(*) FROM 'test/data/ms_counties.parquet'
WHERE st_geomfromgeoarrow('polygon', geometry) <> st_geomfromgeoarrowpolygon(geometry);
----
0

# --- errors are reported at bind time where possible ---

statement error
SELECT st_geomfromgeoarrow('circle', {'x': 1.0, 'y': 2.0});
----
unknown geometry type 'circle'

# nesting depth must match the geometry type
statement error
SELECT st_geomfromgeoarrow('polygon', {'x': 1.0, 'y': 2.0});
----
POLYGON expects STRUCT(x DOUBLE, y DOUBLE)[][]

# an explicit dimension suffix that contradicts the value
statement error
SELECT st_geomfromgeoarrow('point_z', {'x': 1.0, 'y': 2.0});
----
type name says xyz but the value is xy

# the type name has to be a constant, since it selects the reader at bind time
statement error
SELECT st_geomfromgeoarrow(county_name, {'x': 1.0, 'y': 2.0}) FROM 'test/data/ms_counties.parquet';
----
must be a constant string

# a struct that is not a GeoArrow coordinate struct
statement error
SELECT st_geomfromgeoarrow('point', {'lon': 1.0, 'lat': 2.0});
----
No function matches

# --- the write side takes dimensions as an argument ---

# asking for ordinates the geometry does not have is an error rather than silent NaNs
statement error
SELECT st_asgeoarrowpoint('POINT(1 2)'::GEOMETRY, 'xyz');
----
geometry is xy but xyz was requested

statement error
SELECT st_asgeoarrowpoint('POINT(1 2)'::GEOMETRY, 'xyq');
----
unknown dimensions 'xyq'

# projecting down is fine: XY is a subset of XYZ
query I
SELECT st_asgeoarrowpoint('POINT Z (1 2 3)'::GEOMETRY);
----
{'x': 1.0, 'y': 2.0}

# the one-argument forms keep their original XY types, so existing queries are unaffected
query I
SELECT typeof(st_asgeoarrow('POINT(30 10)'::GEOMETRY));
----
STRUCT(geometry_type UTINYINT, xs DOUBLE[], ys DOUBLE[], ring_offsets INTEGER[], geom_offsets INTEGER[])

query I
SELECT typeof(st_asgeoarrowpolygon('POLYGON((0 0, 1 0, 1 1, 0 0))'::GEOMETRY));
----
STRUCT(x DOUBLE, y DOUBLE)[][]

query I
SELECT typeof(st_asgeoarrowpolygon('POLYGON Z ((0 0 1, 1 0 1, 1 1 1, 0 0 1))'::GEOMETRY, 'xyz'));
----
STRUCT(x DOUBLE, y DOUBLE, z DOUBLE)[][]
